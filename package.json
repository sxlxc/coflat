{
  "name": "@chaoxu/coflat",
  "version": "2.1.1",
  "description": "CST-backed Pandoc Markdown editor built on CodeMirror 6 and KaTeX.",
  "type": "module",
  "homepage": "http://chaoxu.prof/coflat/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaoxu/coflat.git"
  },
  "bugs": {
    "url": "https://github.com/chaoxu/coflat/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "katex@0.16.38": "patches/katex@0.16.38.patch"
  },
  "files": [
    "dist",
    "patches"
  ],
  "exports": {
    ".": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.mjs"
    },
    "./document-surface.css": "./dist/document-surface.css",
    "./numeric": {
      "types": "./dist/numeric.d.ts",
      "import": "./dist/numeric.mjs"
    },
    "./latex": {
      "types": "./dist/latex.d.ts",
      "import": "./dist/latex.mjs"
    },
    "./latex/csl/ieee.csl": "./dist/latex/csl/ieee.csl",
    "./latex/filter.lua": "./dist/latex/filter.lua",
    "./latex/syntax-manifest.lua": "./dist/latex/syntax-manifest.lua",
    "./latex/template/article.tex": "./dist/latex/template/article.tex",
    "./latex/template/lipics.tex": "./dist/latex/template/lipics.tex",
    "./themes/blueprint-book.css": "./dist/themes/blueprint-book.css",
    "./style.css": "./dist/editor.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.editor.json && vite build --config vite.editor.config.ts",
    "bench:cst-transactions": "COFLAT_CST_BENCHMARK=1 vitest run src/editor/cst/pandoc-cst-field.bench.test.ts --reporter=verbose",
    "check:cst-long-session": "bun scripts/check-cst-long-session.ts",
    "check:m6-authority": "bun scripts/check-m6-cst-authority.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "check:static": "bun run typecheck && bun run lint",
    "dev:pages": "vite --config vite.pages.config.ts --host 127.0.0.1 --port 5190",
    "build:pages": "vite build --config vite.pages.config.ts",
    "measure:package-graph": "bun run build && bun scripts/measure-package-graph.mjs --assert",
    "check:package": "bun run build && bun run publint",
    "check:package-smoke": "bun run build && bun scripts/package-smoke.mjs",
    "test:watch": "vitest",
    "lint": "biome lint . && bun scripts/check-layer-boundary.mjs && bun scripts/check-m6-cst-authority.mjs",
    "lint:layers": "bun scripts/check-layer-boundary.mjs",
    "publish:gitea": "bun scripts/publish-gitea.mjs",
    "prepack": "bun run build && bun run publint",
    "test:e2e": "env -u NO_COLOR -u FORCE_COLOR playwright test tests/e2e/smoke.spec.ts tests/e2e/editing-assistance.spec.ts tests/e2e/inline-markup.spec.ts tests/e2e/math-source.spec.ts",
    "e2e:install": "playwright install --with-deps chromium firefox"
  },
  "peerDependencies": {
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "citeproc": "^2.4.63",
    "dompurify": "^3.4.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@codemirror/legacy-modes": "^6.5.4",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.5.0",
    "fast-check": "^4.6.0",
    "jsdom": "^29.0.0",
    "katex": "0.16.38",
    "pandocmd-cst": "file:vendor/pandocmd-cst",
    "publint": "^0.3.18",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.0"
  }
}
